			)
		)
		(uuid "5a827e05-b6da-4a12-ad41-0ba367180381")
	)
	(text "Notes: 	- GND system wide corresponds to the PACK- connecion to the BMS system.\n		- VBATT does not mean the positive terminal of the battery. it corresponds\n		  to the voltage supplied by the BMS from the battery. \n		- Each subsystem will be isolated from the power supply with jumpers within \n		  their own schematics.\n		- There are no hierarchichal connectors shown for the power regulators sheet \n		  because the power distribution is shown with globl connectors.\n		- ICHG and PSYS are analog signals that are read by the MCU to determine the \n		  Charge current, and system power respectively"
		(exclude_from_sim no)
		(at 27.94 120.142 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left)
		)
		(uuid "796f59e3-bcae-48b3-8a6d-85c44deafda1")
	)
